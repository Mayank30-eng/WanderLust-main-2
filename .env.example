# Cloudinary Configuration (for listing image uploads)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# Mapbox Configuration (for maps and geocoding)
MY_ACCESS_TOKEN=your_mapbox_token
MAP_TOKEN=your_mapbox_token
MAPBOX_TOKEN=your_mapbox_token

# Database Connection (Local MongoDB or MongoDB Atlas URI)
# For local MongoDB: mongodb://127.0.0.1:27017/wanderlust
ATLASDB_URL=mongodb://127.0.0.1:27017/wanderlust

# Session Secret Key
SECRET=your_secret_key_here
